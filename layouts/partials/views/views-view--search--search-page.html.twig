{#
/**
 * @file
 * Theme override for a main view template.
 *
 * Available variables:
 * - attributes: Remaining HTML attributes for the element.
 * - css_name: A CSS-safe version of the view name.
 * - css_class: The user-specified classes names, if any.
 * - header: The optional header.
 * - footer: The optional footer.
 * - rows: The results of the view query, if any.
 * - empty: The content to display if there are no rows.
 * - pager: The optional pager next/prev links to display.
 * - exposed: Exposed widget form/info to display.
 * - feed_icons: Optional feed icons to display.
 * - more: An optional link to the next page of results.
 * - title: Title of the view, only used when displaying in the admin preview.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the view title.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the view title.
 * - attachment_before: An optional attachment view to be displayed before the
 *   view content.
 * - attachment_after: An optional attachment view to be displayed after the
 *   view content.
 * - dom_id: Unique id for every view being printed to give unique class for
 *   JavaScript.
 * - snap: Whether the view's items should snap to a grid when the window is
     resized.
 *
 * @see template_preprocess_views_view()
 * @see curtistinkers_theme_preprocess_views_view()
 */
#}
{% set section_width = '90%' %}
{% set section_margin_block_start = '0' %}
{% set section_margin_block_end = '32' %}
{% set section_padding_block_start = '16' %}
{% set section_padding_block_end = '16' %}

{% set classes = ['view', 'view-' ~ (id|clean_class), 'view-id-' ~ id, 'view-display-id-' ~ display_id, dom_id ? 'js-view-dom-id-' ~ dom_id] %}

<div {{ attributes.addClass(classes) }}>

  {# Title (only displayed in the damin interface) #}
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}
  {# End title #}

  {# Section #}
  {% embed 'curtistinkers_theme:section' with
    {
      columns: '100',
      mobile_columns: '1',
      width: section_width,
      margin_block_start: section_margin_block_start,
      margin_block_end: section_margin_block_end,
      padding_block_start: section_padding_block_start,
      padding_block_end: section_padding_block_end,
      section_header: true,
      section_footer: true
    }
  %}

    {% block header_slot %}
      {% if header %}
        <div class="view-header">
          {# Page title #}
          {{ include(
            'curtistinkers_theme:heading',
            {
              heading_text: header,
              level: '1',
              text_color: 'primary',
              text_size: 'default',
              align: 'left'
            },
            with_context = false
          ) }}
          {# End page title #}
        </div>
      {% endif %}
    {% endblock %}

    {% block main_slot %}
      {% if exposed %}
        <div class="view-filters">
          {{ exposed }}
        </div>
      {% endif %}

      {% if attachment_before %}
        <div class="attachment attachment-before">
          {{ attachment_before }}
        </div>
      {% endif %}

      {% block view_content %}
        {% if rows %}
          {% if snap %}
            <div
              class="view-content view-snap hide-scrollbar-x relative left-1/2 flex w-screen -translate-x-1/2 snap-x snap-mandatory gap-3 overflow-x-auto md:static md:left-0 md:container md:mx-auto md:grid md:w-auto md:translate-x-0 md:snap-none md:grid-cols-3 md:gap-8 md:overflow-x-visible"
            >
              {{ rows }}
            </div>
          {% else %}
            <div class="view-content">
              {{ rows }}
            </div>
          {% endif %}
        {% elseif empty %}
          <div class="view-empty">
            {{ empty }}
          </div>
        {% endif %}
      {% endblock %}

      {% if pager %}
        {{ pager }}
      {% endif %}

      {% if attachment_after %}
        <div class="attachment attachment-after">
          {{ attachment_after }}
        </div>
      {% endif %}

      {% if more %}
        {{ more }}
      {% endif %}
    {% endblock %}

    {% block footer_slot %}
      {% if footer %}
        <div class="view-footer">
          {{ footer }}
        </div>
      {% endif %}
    {% endblock %}

  {% endembed %}
  {# End section #}

</div>
